{
  "name": "linguadesk",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.api.json --noEmit && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "desktop": "node scripts/launch.mjs",
    "stop": "node scripts/stop-linguadesk.mjs",
    "check:ai": "node scripts/check-ai.mjs",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-desktop-shortcut.ps1",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.69.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^29.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  },
  "description": "LinguaDesk — a quiet desk for English reading, listening, vocabulary and spaced review. Local-first PWA."
}
