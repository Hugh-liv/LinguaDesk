# Copy this file to .env.local and fill in one key.
# Choose one provider: anthropic or deepseek.
# For mainland China, DeepSeek is usually the easiest; set AI_PROVIDER=deepseek.
# Leave blank to auto-detect: Anthropic key first, then DeepSeek.
AI_PROVIDER=

# DeepSeek (OpenAI-compatible; supports function calling with deepseek-chat)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Vision-capable model for photo / screenshot import.
DEEPSEEK_VISION_MODEL=deepseek-flash
# The same Key also powers POST /v1/tools/search (web search).
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic (also supported)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional custom OpenAI-compatible endpoint is not wired yet; use DeepSeek or Anthropic.

# Cloud sync (optional). Use the project base URL, not /rest/v1/.
# The anon/publishable key is public; RLS protects each user's rows.
# Never put a service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side login check for AI requests.
# Vercel requires auth automatically when the Supabase server vars are set.
# Self-host: set REQUIRE_CLOUD_AUTH=1 to require the same login.
SUPABASE_URL=
SUPABASE_ANON_KEY=
REQUIRE_CLOUD_AUTH=
